# --- Database ---
# Local dev via docker-compose (see docker-compose.yml): postgresql://washbay:washbay@localhost:5432/washbay
DATABASE_URL="postgresql://washbay:washbay@localhost:5432/washbay"

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- SMS provider ---
# Set to "console" for local development (prints SMS to server logs instead of sending).
# Set to "kairos" to send real SMS through Kairos Africa once you have credentials.
SMS_PROVIDER="console"
KAIROS_API_BASE_URL="https://api.kairosafrica.example/v1"
KAIROS_API_KEY=""
KAIROS_SENDER_ID="FirstClass"

# --- Business defaults ---
DEFAULT_CURRENCY="GHS"

# --- First owner login (used only by `npm run db:seed`) ---
# Set these BEFORE running the seed command to pick your own login instead
# of the defaults (owner@firstclass.local / ChangeMe123!). Changing them
# after the owner account already exists has no effect — the seed script
# won't overwrite an existing user (see prisma/seed.ts).
SEED_OWNER_EMAIL="owner@firstclass.local"
SEED_OWNER_PASSWORD="ChangeMe123!"
